# Strong password for the local Valkey/Redis (required).
REDIS_PASSWORD=change-me-to-a-long-random-string

# Only needed for the `tls` profile (automatic HTTPS via Caddy):
DOMAIN=tempo.example.com
ACME_EMAIL=you@example.com

# On a droplet, run a prebuilt image instead of building locally:
# TEMPO_IMAGE=ghcr.io/<you>/tempo-app:0.1.0
