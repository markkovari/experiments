# Generated by selfhost — do not edit; edit the app spec and re-deploy.
[Unit]
Description=comp-host: gate (gate.example.com)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/comp-host --component /srv/comp/gate/app.wasm --addr 127.0.0.1:30386 --kv memory --pool
EnvironmentFile=/etc/comp/gate.env
Restart=always
RestartSec=2
DynamicUser=yes
StateDirectory=comp/gate
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
# wasmtime JITs, so it needs W^X — this one cannot be tightened.
MemoryDenyWriteExecute=no

[Install]
WantedBy=multi-user.target
