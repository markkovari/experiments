# Generated by selfhost — do not edit; edit the app spec and re-deploy.
#
# TAILNET ONLY. Two things make that true, and both matter:
#   bind {$TS_IP}  — listens on the Tailscale address alone, so this is
#                    unreachable from the VPS's public interface. The deploy
#                    recipe sets TS_IP from `tailscale ip -4` on the box.
#   tls internal   — a certificate from Caddy's own CA. No ACME, no DNS
#                    provider, no public record. Trust Caddy's root once per
#                    device (`caddy trust`, or install its root.crt) and the
#                    browser is happy — which also gives you a secure context,
#                    without which passkeys and service workers will not run.
#
# The hostname must resolve to that Tailscale address: a custom DNS record in
# the tailnet, or a split-DNS entry. MagicDNS alone gives one name per machine.
gate.example.com {
	bind {$TS_IP}
	tls internal
	reverse_proxy 127.0.0.1:30386
}
